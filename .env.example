# Kopiér til .env og udfyld med dine værdier
# .env må aldrig committes til git (er allerede i .gitignore)

# Mail-modtager og afsender
RECIPIENT_EMAIL=din-mail@example.com
SENDER_EMAIL=din-mail@example.com

# SMTP-server (eksempel for One.com)
# Gmail: smtp.gmail.com:587 — kræver app password
# Outlook: smtp.office365.com:587
SMTP_HOST=send.one.com
SMTP_PORT=587

# SMTP-password (alternativt prompter scriptet ved første kørsel
# og gemmer det obfusceret i .credentials)
SMTP_PASSWORD=

# Anthropic API-nøgle (Claude bruges til at vurdere relevans af jobopslag)
# Hentes fra console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-api03-...
